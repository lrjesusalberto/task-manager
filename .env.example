# --- Producción: MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=task_manager
DB_USER=root
DB_PASSWORD=

# --- Desarrollo local: SQLite ---
# Si se define, tiene prioridad sobre la configuración de MySQL.
# DB_SQLITE=database/tareas.sqlite

# Origen permitido para CORS (* en desarrollo)
CORS_ORIGIN=*

# Mostrar detalles de error en las respuestas (nunca en producción)
APP_DEBUG=false
